{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sieg-beyond-the-vision",
  "account_id": "938941303d29a06bdb9183bc0a9eff69",
  "main": "cloudflare/entry.js",
  "compatibility_date": "2026-11-13",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "www.sieg.ltd",
      "custom_domain": true
    }
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "cloudflare-dist/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sieg-production",
      "database_id": "091e558d-7806-4593-9cba-1602255256d7",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "sieg-production-files"
    }
  ],
  "vars": {
    "GEE_PROJECT_ID": "ee-gee023",
    "REPORT_CHECKOUT_ENABLED": "false",
    "WEEKLY_CROP_ENABLED": "false",
    "PAYGATE_CURRENCY": "USD",
    "CF_ACCESS_TEAM_DOMAIN": "https://sieg-360.cloudflareaccess.com",
    "CF_ACCESS_AUD": "46d0725ece09e95d9abfb7447000568cc6a219d6c3e40907f425e14766c60db1",
    "SIEG_ENV": "production"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "sieg-beyond-the-vision-staging",
      "routes": [],
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "GEE_PROJECT_ID": "ee-gee023",
        "REPORT_CHECKOUT_ENABLED": "false",
        "WEEKLY_CROP_ENABLED": "false",
        "PAYGATE_CURRENCY": "USD",
        "CF_ACCESS_TEAM_DOMAIN": "https://sieg-360.cloudflareaccess.com",
        "CF_ACCESS_AUD": "54ffd8231728756c288e1af0ccfaa6f17eb365788bd8b157f68ef547aaf1700b",
        "SIEG_ENV": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sieg-staging",
          "database_id": "7190c5d9-3fc6-416d-8015-78bc0c863f8f",
          "migrations_dir": "cloudflare/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "sieg-staging-files"
        }
      ]
    }
  }
}

node_modules/
dist/
cloudflare-dist/
.wrangler/
.env*
.dev.vars*
wrangler.before-*.jsonc
*service-account*.json
*credentials*.json
launch-secrets*
__pycache__/
*.pyc
*.pem
*.key
sieg-release-check.txt

node_modules/
dist/
cloudflare-dist/
.wrangler/
__pycache__/
*.pyc
.env
.env.*
.dev.vars
.dev.vars.*
wrangler.before-*
sieg-release-check.txt
*.log
*service-account*.json
*credentials*.json
launch-secrets*.json
wrangler.before-update.jsonc
# Local credentials and release backups
*.p12
